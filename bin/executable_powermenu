#!/usr/bin/env bash
# Menu de energia (rofi) — usado pelo botão da polybar.
set -euo pipefail

lock="󰌾  Bloquear"
logout="󰍃  Sair do i3"
suspend="󰤄  Suspender"
reboot="󰜉  Reiniciar"
windows="󰖳  Reiniciar no Windows"
poweroff="󰐥  Desligar"

options=("$lock" "$logout" "$suspend" "$reboot")
[[ -x "$HOME/bin/boot-windows" ]] && options+=("$windows")
options+=("$poweroff")

rofi_menu() {
    rofi -dmenu -i -no-custom -p "$1" -theme-str 'window {width: 320px;} listview {lines: '"$2"';}'
}

confirm() {
    [[ "$(printf '%s\n' "Não" "Sim" | rofi_menu "$1?" 2)" == "Sim" ]]
}

choice=$(printf '%s\n' "${options[@]}" | rofi_menu "Energia" "${#options[@]}") || exit 0

case "$choice" in
    "$lock")     ~/bin/lock & ;;
    "$logout")   confirm "Sair do i3" && i3-msg exit ;;
    "$suspend")  systemctl suspend ;;
    "$reboot")   confirm "Reiniciar" && systemctl reboot ;;
    "$windows")  confirm "Reiniciar no Windows" && pkexec "$HOME/bin/boot-windows" ;;
    "$poweroff") confirm "Desligar" && systemctl poweroff ;;
esac
