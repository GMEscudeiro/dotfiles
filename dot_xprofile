# ~/.xprofile

# Ferramentas do mise (greenclip, gh...) visíveis para programas abertos pelo i3/rofi
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
PROFILES="$HOME/.config/monitors/profiles.conf"
LAST="$HOME/.config/monitors/.last_profile"

if [[ -f "$LAST" ]]; then
  CHOICE=$(cat "$LAST")
  CMD=$(grep "^${CHOICE}|" "$PROFILES" | cut -d'|' -f2-)
  [[ -n "$CMD" ]] && eval "$CMD"
fi

