# ~/.xprofile
PROFILES="$HOME/.config/monitors/profiles.conf"
LAST="$HOME/.config/monitors/.last_profile"

if [[ -f "$LAST" ]]; then
  CHOICE=$(cat "$LAST")
  CMD=$(grep "^${CHOICE}|" "$PROFILES" | cut -d'|' -f2-)
  [[ -n "$CMD" ]] && eval "$CMD"
fi

